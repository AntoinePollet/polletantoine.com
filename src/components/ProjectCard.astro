---
import ProjectVisual from './ProjectVisual.astro';
import { kanjiNumerals, localizePath, t, type Lang } from '../i18n/ui';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
  lang: Lang;
}

const { project, index, lang } = Astro.props;
const { title, description, cover, kanji, year, tags } = project.data;
const href = localizePath(`/projects/${projectSlug(project)}/`, lang);
---

<article class="group" data-reveal style={`--delay: ${(index % 2) * 140}ms`}>
  <a href={href} class="block">
    <ProjectVisual
      image={cover}
      kanji={kanji}
      alt={title}
      label={t(lang, 'placeholder.label')}
      width={900}
    />
    <div class="mt-5 flex items-center gap-3 text-xs tracking-widest text-muted">
      <span class="font-serif text-sm text-shu">{kanjiNumerals[index] ?? index + 1}</span>
      <span
        class="h-px w-6 bg-line transition-all duration-500 group-hover:w-12 group-hover:bg-shu"
        aria-hidden="true"></span>
      <span>{year}</span>
    </div>
    <h3 class="mt-2 font-serif text-2xl tracking-wide transition group-hover:text-shu">
      {title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">{description}</p>
    {
      tags.length > 0 && (
        <p class="mt-3 text-xs text-muted">{tags.slice(0, 4).join(' ・ ')}</p>
      )
    }
  </a>
</article>
