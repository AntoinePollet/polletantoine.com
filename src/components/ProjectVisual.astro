---
// Screenshot, or a wave-pattern placeholder with the project's kanji until one is provided.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  kanji: string;
  alt: string;
  label: string;
  ratio?: string;
  width?: number;
  eager?: boolean;
  class?: string;
}

const {
  image,
  kanji,
  alt,
  label,
  ratio = 'aspect-[19/10]',
  width = 1200,
  eager = false,
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'relative isolate overflow-hidden rounded-2xl border border-line transition duration-500 ease-out group-hover:-translate-y-1 group-hover:shadow-[0_18px_40px_-20px_rgb(0_0_0/0.45)]',
    ratio,
    className,
  ]}
>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        width={width}
        loading={eager ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-top transition duration-700 ease-out group-hover:scale-[1.03]"
      />
    ) : (
      <div class="wave-pattern absolute inset-0 grid place-items-center" role="img" aria-label={`${alt} — ${label}`}>
        <span
          aria-hidden="true"
          class="font-serif text-[clamp(4rem,14vw,9rem)] leading-none text-shu transition duration-500 group-hover:-translate-y-1"
        >
          {kanji}
        </span>
        <span class="absolute bottom-3 left-4 rounded bg-paper-deep px-1 text-[0.65rem] uppercase tracking-[0.25em] text-muted">
          {label}
        </span>
      </div>
    )
  }
</div>
