---
import SocialLinks from './SocialLinks.astro';
import Hanko from './Hanko.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm text-muted md:flex-row md:items-center"
  >
    <p class="flex items-center gap-3">
      <Hanko />
      © {year} Antoine Pollet — {t(lang, 'footer.role')}
    </p>
    <SocialLinks />
  </div>
</footer>
