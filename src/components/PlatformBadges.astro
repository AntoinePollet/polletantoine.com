---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  links: {
    website?: string;
    appStore?: string;
    playStore?: string;
    github?: string;
  };
}

const { lang, links } = Astro.props;

const badges = (['website', 'appStore', 'playStore', 'github'] as const)
  .map((key) => ({ key, label: t(lang, `link.${key}`), href: links[key] }))
  .filter((b) => b.href);
---

{
  badges.length > 0 && (
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {badges.map((badge) => (
        <li>
          <a
            href={badge.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 border-b border-ink pb-0.5 text-sm transition hover:border-shu hover:text-shu"
          >
            {badge.label}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
