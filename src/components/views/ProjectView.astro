---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformBadges from '../PlatformBadges.astro';
import ProjectVisual from '../ProjectVisual.astro';
import { localizePath, t, type Lang } from '../../i18n/ui';
import { getProjects, projectSlug, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { Content } = await render(project);
const { title, description, cover, gallery, kanji, kanjiMeaning, year, tags, links } =
  project.data;

const projects = await getProjects(lang);
const i = projects.findIndex((p) => p.id === project.id);
const prev = i > 0 ? projects[i - 1] : undefined;
const next = i < projects.length - 1 ? projects[i + 1] : undefined;
const projectHref = (p: Project) => localizePath(`/projects/${projectSlug(p)}/`, lang);

const placeholder = t(lang, 'placeholder.label');
// Until real screenshots are provided, show two placeholder slots.
const galleryItems = gallery.length > 0 ? gallery : [undefined, undefined];
---

<BaseLayout lang={lang} title={`${title} — Antoine Pollet`} description={description}>
  <a
    href={`${localizePath('/', lang)}#projects`}
    class="mb-12 inline-flex items-center gap-2 text-sm text-muted hover:text-shu"
  >
    <span aria-hidden="true">←</span>
    {t(lang, 'project.back')}
  </a>

  <article>
    <header class="mb-14 grid gap-8 md:grid-cols-[auto_1fr] md:gap-14">
      <div data-reveal class="flex items-end gap-3 md:flex-col md:items-center">
        <span class="brush font-serif text-7xl leading-none text-shu md:text-8xl" aria-hidden="true">
          {kanji}
        </span>
        <span class="text-xs tracking-[0.3em] text-muted md:vertical md:mt-3">{kanjiMeaning}</span>
      </div>

      <div>
        <h1 data-reveal style="--delay: 100ms" class="font-serif text-5xl tracking-wide md:text-7xl">{title}</h1>
        <p data-reveal style="--delay: 200ms" class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{description}</p>

        <dl data-reveal style="--delay: 300ms" class="mt-10 grid max-w-2xl grid-cols-[6rem_1fr] border-t border-line text-sm">
          <dt class="border-b border-line py-3 text-muted">{t(lang, 'project.year')}</dt>
          <dd class="border-b border-line py-3">{year}</dd>
          {
            tags.length > 0 && (
              <>
                <dt class="border-b border-line py-3 text-muted">{t(lang, 'project.stack')}</dt>
                <dd class="border-b border-line py-3 leading-relaxed">{tags.join(' ・ ')}</dd>
              </>
            )
          }
          <dt class="py-3 text-muted">{t(lang, 'project.links')}</dt>
          <dd class="py-3"><PlatformBadges lang={lang} links={links} /></dd>
        </dl>
      </div>
    </header>

    <div data-reveal style="--delay: 350ms">
      <ProjectVisual image={cover} kanji={kanji} alt={title} label={placeholder} width={2000} eager />
    </div>

    <section class="mt-6" aria-label={t(lang, 'project.gallery')}>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          galleryItems.map((img, n) => (
            <div
              data-reveal
              style={`--delay: ${(n % 2) * 140}ms`}
              class={galleryItems.length % 2 === 1 && n === galleryItems.length - 1 ? 'sm:col-span-2' : ''}
            >
              <ProjectVisual
                image={img}
                kanji={kanji}
                alt={`${title} — ${t(lang, 'project.gallery')} ${n + 1}`}
                label={placeholder}
                width={1400}
              />
            </div>
          ))
        }
      </div>
    </section>

    <div data-reveal class="prose prose-lg mx-auto mt-20 max-w-3xl prose-headings:tracking-wide prose-a:underline-offset-4">
      <Content />
    </div>
  </article>

  <nav class="mt-24 grid grid-cols-2 gap-6 border-t border-line pt-8 text-sm">
    <div>
      {
        prev && (
          <a href={projectHref(prev)} class="group block">
            <span class="text-xs tracking-widest text-muted">← {t(lang, 'project.prev')}</span>
            <span class="mt-1 block font-serif text-xl group-hover:text-shu">{prev.data.title}</span>
          </a>
        )
      }
    </div>
    <div class="text-right">
      {
        next && (
          <a href={projectHref(next)} class="group block">
            <span class="text-xs tracking-widest text-muted">{t(lang, 'project.next')} →</span>
            <span class="mt-1 block font-serif text-xl group-hover:text-shu">{next.data.title}</span>
          </a>
        )
      }
    </div>
  </nav>
</BaseLayout>
